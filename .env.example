# Polar Energy AI - Environment Configuration Example
# Copy this file to .env and configure your values

# OpenWeather API Configuration
# Get your API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_PROVIDER=openweather
WEATHER_CACHE_TTL_SECONDS=600

# Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=60.0

# Station Location Defaults (Maitri Base, Queen Maud Land, Antarctica)
DEFAULT_STATION_ID=ST-01
STATION_LAT=-70.7661
STATION_LON=11.7322

# Supabase Authentication (use the browser-safe anon/publishable key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
